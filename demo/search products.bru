meta {
  name: search products
  type: http
  seq: 7
}

get {
  url: http://localhost:8000/api/products/search
  body: json
  auth: basic
}

headers {
  X-Tenant-Id: tenant2
}

auth:basic {
  username: user1
  password: password
}

body:json {
  {
    "params": {
      "searchTerms": "Stock"
    },
    "paging": {
      "pageSize": 30,
      "offset": 0
    }
    
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
