meta {
  name: search products
  type: http
  seq: 7
}

get {
  url: http://localhost:8000/api/products/search
  body: json
  auth: basic
}

headers {
  X-Tenant-Id: tenant1
}

auth:basic {
  username: admin
  password: password
}

body:json {
  {
    "params": {
      "searchTerms": "a",
      "includes": ["id", "title", "dimensions"],
      "sort": {
        "id": "asc",
        "title": "desc"
      },
      "attributesToHighlight": ["title"],
      "highlightPreTag": "<span>",
      "highlightPostTag": "</span>"
    },
    "paging": {
      "offset": 0,
      "limit": 20
    }
    
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
